# Copy this file to ".env" and fill in your values. NEVER commit the real .env file.

# Which AI answers your chat: "ollama" (local, unlimited) or "gemini" (cloud, daily quota)
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2

# Gemini key (needed for provider=gemini, and for live web search in either mode)
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Optional settings
USER_NAME=Boss
VOICE_LANG=en-IN
VOICE_INDEX=0
VOICE_RATE=175
